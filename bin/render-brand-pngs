#!/usr/bin/env python3
# Render the PNG brand assets in public/brand/ from the SVG marks in
# src/assets/brand/ (rounded rects only, so a tiny Pillow rasterizer does it).
# Run from the repo root after changing a mark: bin/render-brand-pngs
import re, sys
from PIL import Image, ImageDraw
def render(svg, size, out):
    src = open(svg).read()
    ss = 8; S = size*ss; k = S/32
    im = Image.new('RGBA', (S, S), (0,0,0,0)); d = ImageDraw.Draw(im)
    fill = None
    for m in re.finditer(r'<g fill="(#[0-9A-Fa-f]{6})">|</g>|<rect ([^>]*)/>', src):
        if m.group(1): fill = m.group(1); continue
        if m.group(0) == '</g>': fill = None; continue
        a = dict(re.findall(r'(\w+)="([^"]*)"', m.group(2)))
        x,y,w,h = (float(a[n]) for n in ('x','y','width','height')); r = float(a.get('rx',0))
        d.rounded_rectangle([x*k, y*k, (x+w)*k-1, (y+h)*k-1], radius=r*k, fill=a.get('fill', fill))
    im.resize((size,size), Image.LANCZOS).save(out)
B='src/assets/brand'
render(f'{B}/field-struct-mark.svg', 180, 'public/brand/apple-touch-icon.png')
render(f'{B}/field-struct-mark.svg', 512, 'public/brand/field-struct-mark-512.png')
render(f'{B}/actionable-mark.svg', 512, 'public/brand/actionable-mark-512.png')
